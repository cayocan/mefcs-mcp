{
  "name": "mefcs-mcp",
  "version": "0.1.0",
  "description": "MCP server to control M-VAVE pedals (Tank-G first) through the M-EFCS USB bridge",
  "license": "MIT",
  "author": "Cayo Aguiar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cayocan/mefcs-mcp.git"
  },
  "homepage": "https://github.com/cayocan/mefcs-mcp#readme",
  "bugs": {
    "url": "https://github.com/cayocan/mefcs-mcp/issues"
  },
  "type": "module",
  "main": "dist/src/server.js",
  "bin": {
    "mefcs-mcp": "dist/src/server.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/src/server.js",
    "test": "node --test dist/test/golden.test.js dist/test/tone3000.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "mcpName": "io.github.cayocan/mefcs-mcp",
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "README.pt-BR.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "m-vave",
    "tank-g",
    "m-efcs",
    "guitar",
    "nam",
    "tone3000",
    "impulse-response"
  ],
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  }
}
